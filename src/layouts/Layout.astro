---
// Layout.astro - Master Layout with Swiss Minimalist Typography and Metadata
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Yonopod by Devtrine | Web Cloud Storage Fleksibel Rp 250 / GB - Bebas Hambatan CORB",
  description = "Platform cloud storage berbasis web dengan skema bayar sesuai penggunaan Rp 250/GB. Solusi penyimpanan adil dan terjangkau untuk pelajar, mahasiswa, dan UMKM tanpa langganan kaku."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0e1a" />
    
    <!-- OpenGraph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Yonopod Cloud" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  </head>
  <body class="bg-[#f8fafc] text-[#0f172a] font-sans antialiased selection:bg-[#06b6d4]/20 selection:text-[#0f172a]">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
